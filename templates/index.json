a-review-card\">\n\n      <img \n        class=\"review-photo\"\n        src=\"https://cdn.shopify.com/s/files/1/0991/0576/7801/files/sofie.avif?v=1778345806\"\n        alt=\"Sophie M.\"\n      >\n\n      <div class=\"review-content\">\n\n        <div class=\"stars\">★★★★★</div>\n\n        <p class=\"review-text\">\n          \"En 6 semaines, mes cheveux ont retrouvé une densité que je n’avais plus depuis des années. Le tube est petit mais très concentré.\"\n        </p>\n\n        <div class=\"review-name\">\n          <strong>Sophie M.</strong>\n          <span>Paris, France</span>\n          <em>✓ Achat vérifié</em>\n        </div>\n\n      </div>\n\n    </div>\n\n    <div class=\"elixara-review-card\">\n\n      <img \n        class=\"review-photo\"\n        src=\"https://cdn.shopify.com/s/files/1/0991/0576/7801/files/bart.avif?v=1778345818\"\n        alt=\"Bart V.\"\n      >\n\n      <div class=\"review-content\">\n\n        <div class=\"stars\">★★★★★</div>\n\n        <p class=\"review-text\">\n          \"Je voyais mes tempes se dégarnir depuis des années. Après 3 mois d’utilisation, mes cheveux paraissent plus forts et plus denses.\"\n        </p>\n\n        <div class=\"review-name\">\n          <strong>Bart V.</strong>\n          <span>Marseille, France</span>\n          <em>✓ Achat vérifié</em>\n        </div>\n\n      </div>\n\n    </div>\n\n  </div>\n\n</section>\n\n<style>\n\n.elixara-routine{\n  background:#f4f0e7;\n  padding:70px 20px;\n  overflow:hidden;\n}\n\n.elixara-title{\n  text-align:center;\n  margin-bottom:45px;\n}\n\n.elixara-title p{\n  color:#c8ab63;\n  letter-spacing:7px;\n  font-size:14px;\n  margin:0 0 18px;\n}\n\n.elixara-title h2{\n  font-family:serif;\n  font-size:clamp(42px,6vw,72px);\n  line-height:1.05;\n  font-weight:400;\n  color:#111;\n  margin:0;\n}\n\n.elixara-title h2 span{\n  color:#2f6b46;\n  font-style:italic;\n}\n\n.elixara-steps{\n  max-width:1200px;\n  margin:0 auto 70px;\n  display:grid;\n  grid-template-columns:repeat(4,1fr);\n  gap:22px;\n}\n\n.elixara-steps img{\n  width:100%;\n  display:block;\n  border-radius:28px;\n  box-shadow:0 12px 35px rgba(0,0,0,0.08);\n}\n\n.elixara-stats{\n  background:#0c2b1b;\n  max-width:1200px;\n  margin:0 auto 80px;\n  padding:55px 35px;\n  display:grid;\n  grid-template-columns:repeat(4,1fr);\n  gap:25px;\n  text-align:center;\n}\n\n.elixara-stats div{\n  border-right:1px solid rgba(255,255,255,0.18);\n  padding:0 18px;\n}\n\n.elixara-stats div:last-child{\n  border-right:none;\n}\n\n.elixara-stats strong{\n  display:block;\n  color:#d6b76a;\n  font-family:serif;\n  font-size:clamp(42px,5vw,70px);\n  font-weight:400;\n  line-height:1;\n  margin-bottom:18px;\n}\n\n.elixara-stats span{\n  display:block;\n  color:rgba(255,255,255,0.72);\n  text-transform:uppercase;\n  letter-spacing:5px;\n  font-size:13px;\n  line-height:1.4;\n}\n\n.testimonials-title{\n  margin-top:20px;\n}\n\n.elixara-reviews{\n  max-width:1150px;\n  margin:0 auto;\n  display:grid;\n  grid-template-columns:repeat(3,1fr);\n  gap:28px;\n}\n\n.elixara-review-card{\n  background:#fff;\n  border-radius:34px;\n  overflow:hidden;\n  box-shadow:0 14px 40px rgba(0,0,0,0.06);\n}\n\n.review-photo{\n  width:100%;\n  aspect-ratio:1/1;\n  object-fit:contain;\n  background:#f7f4ee;\n  padding:12px;\n  display:block;\n}\n\n.review-content{\n  padding:32px;\n}\n\n.stars{\n  color:#c8ab63;\n  font-size:22px;\n  letter-spacing:3px;\n  margin-bottom:20px;\n}\n\n.review-text{\n  font-family:serif;\n  font-style:italic;\n  font-size:22px;\n  line-height:1.65;\n  color:#111;\n  margin:0 0 28px;\n}\n\n.review-name strong{\n  display:block;\n  font-size:17px;\n  letter-spacing:3px;\n  color:#111;\n  text-transform:uppercase;\n}\n\n.review-name span{\n  display:block;\n  font-size:15px;\n  color:#777;\n  margin-top:5px;\n}\n\n.review-name em{\n  display:block;\n  margin-top:9px;\n  color:#2f6b46;\n  font-style:normal;\n  font-size:13px;\n  letter-spacing:2px;\n  text-transform:uppercase;\n}\n\n@media screen and (max-width:768px){\n\n  .elixara-routine{\n    padding:55px 0;\n  }\n\n  .elixara-title{\n    padding:0 20px;\n    margin-bottom:35px;\n  }\n\n  .elixara-title p{\n    font-size:12px;\n    letter-spacing:6px;\n  }\n\n  .elixara-title h2{\n    font-size:42px;\n  }\n\n  .elixara-steps{\n    display:flex;\n    overflow-x:auto;\n    gap:18px;\n    padding:0 20px 12px;\n    scroll-snap-type:x mandatory;\n    -webkit-overflow-scrolling:touch;\n  }\n\n  .elixara-steps img{\n    min-width:82%;\n    scroll-snap-align:center;\n    flex-shrink:0;\n    border-radius:26px;\n  }\n\n  .elixara-steps::-webkit-scrollbar{\n    display:none;\n  }\n\n  .elixara-stats{\n    display:flex;\n    overflow-x:auto;\n    gap:18px;\n    margin:45px 0 70px;\n    padding:45px 20px;\n    scroll-snap-type:x mandatory;\n    -webkit-overflow-scrolling:touch;\n  }\n\n  .elixara-stats div{\n    min-width:75%;\n    flex-shrink:0;\n    scroll-snap-align:center;\n    border-right:1px solid rgba(255,255,255,0.18);\n    padding:0 25px;\n  }\n\n  .elixara-stats::-webkit-scrollbar{\n    display:none;\n  }\n\n  .elixara-stats strong{\n    font-size:54px;\n  }\n\n  .elixara-stats span{\n    font-size:11px;\n    letter-spacing:4px;\n  }\n\n  .elixara-reviews{\n    display:flex;\n    flex-direction:column;\n    gap:22px;\n    padding:0 20px;\n  }\n\n  .elixara-review-card{\n    width:100%;\n    border-radius:30px;\n  }\n\n  .review-photo{\n    width:100%;\n    height:auto;\n    max-height:none;\n    object-fit:contain;\n    background:#f7f4ee;\n    padding:10px;\n  }\n\n  .review-content{\n    padding:28px;\n  }\n\n  .review-text{\n    font-size:22px;\n    line-height:1.65;\n  }\n\n  .review-name strong{\n    font-size:15px;\n    letter-spacing:2px;\n  }\n\n  .review-name span{\n    font-size:14px;\n  }\n\n  .review-name em{\n    font-size:12px;\n    letter-spacing:1.5px;\n  }\n}\n</style>",
