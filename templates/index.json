een and (max-width:768px){\n\n  .elixara-routine{\n    padding:55px 0;\n  }\n\n  .elixara-title{\n    padding:0 20px;\n    margin-bottom:35px;\n  }\n\n  .elixara-title p{\n    font-size:12px;\n    letter-spacing:6px;\n  }\n\n  .elixara-title h2{\n    font-size:42px;\n  }\n\n  .elixara-steps{\n    display:flex;\n    overflow-x:auto;\n    gap:18px;\n    padding:0 20px 12px;\n    scroll-snap-type:x mandatory;\n    -webkit-overflow-scrolling:touch;\n  }\n\n  .elixara-steps img{\n    min-width:82%;\n    scroll-snap-align:center;\n    flex-shrink:0;\n    border-radius:26px;\n  }\n\n  .elixara-steps::-webkit-scrollbar{\n    display:none;\n  }\n\n  .elixara-stats{\n    display:flex;\n    overflow-x:auto;\n    gap:18px;\n    margin:45px 0 70px;\n    padding:45px 20px;\n    scroll-snap-type:x mandatory;\n    -webkit-overflow-scrolling:touch;\n  }\n\n  .elixara-stats div{\n    min-width:75%;\n    flex-shrink:0;\n    scroll-snap-align:center;\n    border-right:1px solid rgba(255,255,255,0.18);\n    padding:0 25px;\n  }\n\n  .elixara-stats::-webkit-scrollbar{\n    display:none;\n  }\n\n  .elixara-stats strong{\n    font-size:54px;\n  }\n\n  .elixara-stats span{\n    font-size:11px;\n    letter-spacing:4px;\n  }\n\n  .elixara-reviews{\n    display:flex;\n    flex-direction:column;\n    gap:22px;\n    padding:0 20px;\n  }\n\n  .elixara-review-card{\n    width:100%;\n    border-radius:30px;\n  }\n\n  .review-photo{\n    width:100%;\n    height:auto;\n    max-height:none;\n    object-fit:contain;\n    background:#f7f4ee;\n    padding:10px;\n  }\n\n  .review-content{\n    padding:28px;\n  }\n\n  .review-text{\n    font-size:22px;\n    line-height:1.65;\n  }\n\n  .review-name strong{\n    font-size:15px;\n    letter-spacing:2px;\n  }\n\n  .review-name span{\n    font-size:14px;\n  }\n\n  .review-name em{\n    font-size:12px;\n    letter-spacing:1.5px;\n  }\n}\n</style>",
