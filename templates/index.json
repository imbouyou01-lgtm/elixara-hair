ze:13px;\n  font-weight:700;\n  display:flex;\n  align-items:center;\n  gap:8px;\n}\n\n@media(min-width:750px){\n  .elixara-scroll-trust{\n    overflow:visible;\n    flex-wrap:wrap;\n  }\n\n  .elixara-scroll-trust div{\n    min-width:unset;\n    flex:1 1 calc(33.333% - 10px);\n  }\n}\n</style>",
