a-review-card\">\n\n      <img \n        class=\"review-photo\"\n        src=\"https://cdn.shopify.com/s/files/1/0991/0576/7801/files/sofie.avif?v=1778345806\"\n        alt=\"Sophie M.\"\n      >\n\n      <div class=\"review-content\">\n\n        <div class=\"stars\">★★★★★</div>\n\n        <p class=\"review-text\">\n          \"En 6 semaines, mes cheveux ont retrouvé une densité que je n’avais plus depuis des années. Le tube est petit mais très concentré.\"\n        </p>\n\n        <div class=\"review-name\">\n          <strong>Sophie M.</strong>\n          <span>Paris, France</span>\n          <em>✓ Achat vérifié</em>\n        </div>\n\n      </div>\n\n    </div>\n\n    <div class=\"elixara-review-card\">\n\n      <img \n        class=\"review-photo\"\n        src=\"https://cdn.shopify.com/s/files/1/0991/0576/7801/files/bart.avif?v=1778345818\"\n        alt=\"Bart V.\"\n      >\n\n      <div class=\"review-content\">\n\n        <div class=\"stars\">★★★★★</div>\n\n        <p class=\"review-text\">\n          \"Je voyais mes tempes se dégarnir depuis des années. Après 3 mois d’utilisation, mes cheveux paraissent plus forts et plus denses.\"\n        </p>\n\n        <div class=\"review-name\">\n          <strong>Bart V.</strong>\n          <span>Marseille, France</span>\n          <em>✓ Achat vérifié</em>\n        </div>\n\n      </div>\n\n    </div>\n\n  </div>\n\n</section>\n\n<style>\n\n.elixara-routine{\n  background:#f4f0e7;\n  padding:70px 20px;\n  overflow:hidden;\n}\n\n.elixara-title{\n  text-align:center;\n  margin-bottom:45px;\n}\n\n.elixara-title p{\n  color:#c8ab63;\n  letter-spacing:7px;\n  font-size:14px;\n  margin:0 0 18px;\n}\n\n.elixara-title h2{\n  font-family:serif;\n  font-size:clamp(42px,6vw,72px);\n  line-height:1.05;\n  font-weight:400;\n  color:#111;\n  margin:0;\n}\n\n.elixara-title h2 span{\n  color:#2f6b46;\n  font-style:italic;\n}\n\n.elixara-steps{\n  max-width:1200px;\n  margin:0 auto 70px;\n  display:grid;\n  grid-template-columns:repeat