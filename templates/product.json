dding:22px 0;\n  font-size:16px;\n  font-weight:900;\n  color:#111111;\n  position:relative;\n}\n\n.faq-item summary::-webkit-details-marker{\n  display:none;\n}\n\n.faq-item summary::after{\n  content:\"+\";\n  position:absolute;\n  right:0;\n  color:#B58A2F;\n  font-size:26px;\n}\n\n.faq-item[open] summary::after{\n  content:\"−\";\n}\n\n@media(min-width:750px){\n  .elixara-top-trust{\n    grid-template-columns:repeat(4,1fr);\n  }\n\n  .elixara-benefits-list{\n    grid-template-columns:repeat(2,1fr);\n  }\n\n  .elixara-steps{\n    display:grid;\n    grid-template-columns:repeat(4,1fr);\n    max-width:1200px;\n    margin:0 auto 70px;\n  }\n\n  .elixara-steps img{\n    min-width:unset;\n    width:100%;\n  }\n\n  .elixara-stats{\n    display:grid;\n    grid-template-columns:repeat(4,1fr);\n    max-width:1200px;\n    margin:0 auto 80px;\n  }\n\n  .elixara-stats div{\n    min-width:unset;\n  }\n\n  .elixara-reviews{\n    display:grid;\n    grid-template-columns:repeat(3,1fr);\n    max-width:1150px;\n    margin:auto;\n  }\n}\n</style>",
